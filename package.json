{
  "name": "longtable-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @longtable/web",
    "build": "npm run build --workspace @longtable/web",
    "typecheck": "npm run typecheck --workspace @longtable/web",
    "db:start": "supabase start -x imgproxy,edge-runtime,logflare,vector,supavisor,studio,postgres-meta",
    "db:reset": "supabase db reset",
    "probe:sign-in": "node probes/sign-in.mjs",
    "probe:headless": "node probes/headless.mjs",
    "test:unit": "node tools/suites.mjs unit",
    "test:db": "node tools/suites.mjs db"
  },
  "devDependencies": {
    "playwright-core": "1.64.0",
    "supabase": "2.120.0"
  }
}
