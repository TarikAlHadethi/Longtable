{
  "name": "longtable-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @longtable/web",
    "build": "npm run build --workspace @longtable/web",
    "typecheck": "npm run typecheck --workspace @longtable/web",
    "db:start": "supabase start -x storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,studio,postgres-meta",
    "db:reset": "supabase db reset",
    "probe:sign-in": "node probes/sign-in.mjs",
    "probe:headless": "node probes/headless.mjs"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/headless": "^6.0.0",
    "playwright-core": "1.64.0",
    "supabase": "2.120.0"
  }
}
